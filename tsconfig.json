{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "jsx": "react-jsx",
        "allowJs": false,
        "removeComments": false,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "paths": {
            "getsyntux": ["./src/index.ts"],
            "getsyntux/client": ["./src/client.ts"],
            "getsyntux/server": ["./src/server/index.ts"],
        }
    },
    "exclude": ["./dist/**/*"]
}